OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
APP_ENV=development
# SESSION_SECRET requires 32+ random characters in production.
# APP_PASSWORD is only used by explicit local legacy mode.
APP_PASSWORD=
SESSION_SECRET=
# Optional temporary capability link for the owner. Use 32+ random characters,
# keep the resulting URL private, and remove the value after normal sign-in works.
OWNER_PREVIEW_TOKEN=
DATA_DIR=./data
DAILY_GENERATION_LIMIT=20

# Verified accounts are the default; legacy is local-development only.
STUDIO_AUTH_MODE=accounts
PUBLIC_BASE_URL=http://127.0.0.1:8765
SMTP_HOST=smtp.zeptomail.in
SMTP_PORT=465
SMTP_USERNAME=emailapikey
SMTP_PASSWORD=
MAIL_FROM=hello@hridaanlabs.com
MAIL_REPLY_TO=prashant@hridaanlabs.com
# Production registration requires reviewed policies for registered users.
ACCOUNT_POLICIES_REVIEWED=false
PRIVACY_POLICY_URL=https://hridaanlabs.com/privacy
TERMS_URL=


